#!/bin/sh
#
# @name Typhoon H480 SITL
#
# @type Hexarotor x
#

. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 13

param set-default MC_PITCHRATE_P 0.0800
param set-default MC_PITCHRATE_I 0.0400
param set-default MC_PITCHRATE_D 0.0010
param set-default MC_PITCH_P 9.0
param set-default MC_ROLLRATE_P 0.0800
param set-default MC_ROLLRATE_I 0.0400
param set-default MC_ROLLRATE_D 0.0010
param set-default MC_ROLL_P 9.0
param set-default MPC_XY_VEL_I_ACC 4
param set-default MPC_XY_VEL_P_ACC 3

param set-default RTL_DESCEND_ALT 10

param set-default TRIG_INTERFACE 3
param set-default TRIG_MODE 4
param set MNT_MODE_IN 0   # zzu_fly: 用 set 而非 set-default —— eeprom 已存旧值 4，set-default 不会覆盖
param set-default MNT_MODE_OUT 2
param set-default MAV_PROTO_VER 2

set MIXER hexa_x

# zzu_fly: 纯 offboard（无 RC）——关掉 RC/数据链 failsafe，否则解锁后立刻 failsafe 且 OFFBOARD 被拒
param set NAV_DLL_ACT 0
param set COM_RC_LOSS_T 0
param set COM_RC_IN_MODE 4   # 4 = Stick input disabled（显式禁用摇杆输入与其检查）
param save   # zzu_fly: 让上面的 failsafe 相关参数写进 eeprom，下次引导在 commander 启动前生效
